# =============================================================================
# Refine — environment variables (copy this file to `.env` and fill every value)
# =============================================================================
# Never commit `.env`. It is gitignored.
#
# WHERE TO GET EACH VALUE
# -----------------------
# Supabase (https://supabase.com/dashboard → your project → Project Settings → API)
#
#   1) SUPABASE_URL / VITE_SUPABASE_URL
#      → "Project URL" (e.g. https://abcdefghijklmnop.supabase.co)
#      → Use the SAME URL for both variables.
#
#   2) SUPABASE_PROJECT_ID / VITE_SUPABASE_PROJECT_ID
#      → The short id in that URL (the subdomain before .supabase.co)
#      → Same id for both variables.
#
#   3) SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PUBLISHABLE_KEY
#      → "Publishable key" (starts with sb_publishable_)
#      → Safe for the browser; use the SAME key for both variables.
#
#   4) SUPABASE_SERVICE_ROLE_KEY  (server only — never prefix with VITE_)
#      → "Secret key" / service role (starts with sb_secret_)
#      → Used by server functions with admin access. Do not expose to the client.
#
# Cerebras (https://cloud.cerebras.ai → API keys) — optional
#
#   5) CEREBRAS_API_KEY
#      → Create an API key (often starts with csk_)
#      → Powers "AI-enhanced analysis" on the optimize page.
#      → Leave as placeholder or remove the line to use deterministic-only scoring.
#
# After editing `.env`, restart: npm run dev
# =============================================================================

# --- Server (SSR, server functions, auth middleware) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- Browser (Vite inlines these at build/dev time; must match server project above) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# --- AI (server only) ---
CEREBRAS_API_KEY=csk_REPLACE_ME
